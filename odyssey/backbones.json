{
  "_note": "One entry per execution backbone. model = the id that backbone's own API expects. base_url_env / api_key_env name the .env variables holding its endpoint and key (never the values). All endpoints must speak the OpenAI chat-completions API. Model ids other than claude-opus-5.5 and qwen3.8-27b are placeholders: check each against its provider's docs.",
  "claude-opus-5.5":  {"model": "claude-opus-5-5",              "base_url_env": "CLAUDE_BASE_URL",  "api_key_env": "CLAUDE_API_KEY"},
  "gpt-6-astra":      {"model": "gpt-6-astra",                  "base_url_env": "GPT6_BASE_URL",    "api_key_env": "GPT6_API_KEY"},
  "muse-glimmer-30b": {"model": "meta-models/Muse-Glimmer-30B", "base_url_env": "MUSE_BASE_URL",    "api_key_env": "MUSE_API_KEY"},
  "gemini-3.8-flash": {"model": "gemini-3.8-flash",             "base_url_env": "GEMINI_BASE_URL",  "api_key_env": "GEMINI_API_KEY"},
  "kimi-k3":          {"model": "kimi-k3",                      "base_url_env": "KIMI_BASE_URL",    "api_key_env": "KIMI_API_KEY"},
  "grok-4.7":         {"model": "grok-4.7",                     "base_url_env": "GROK_BASE_URL",    "api_key_env": "GROK_API_KEY"},
  "minimax-m3":       {"model": "MiniMax-M3",                   "base_url_env": "MINIMAX_BASE_URL", "api_key_env": "MINIMAX_API_KEY"},
  "glm-5.3":          {"model": "glm-5.3",                      "base_url_env": "GLM_BASE_URL",     "api_key_env": "GLM_API_KEY"},
  "qwen3.8-27b":      {"model": "Qwen/Qwen3.8-27B",             "base_url_env": "QWEN_BASE_URL",    "api_key_env": "QWEN_API_KEY", "key_required": false}
