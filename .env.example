# Vertex Gemini: authenticate with gcloud auth application-default login.
# Select --provider vertex explicitly for each model role.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# Optional main-branch providers; store secrets in ignored local files.
# OPENROUTER_API_KEY_FILE=openrouter_api_key.txt
# OPENAI_API_KEY_FILE=openai_api_key.txt
# AZURE_OPENAI_API_KEY_FILE=azure_api_key.txt
# AZURE_OPENAI_BASE_URL=https://your-endpoint/openai/v1
# Select --provider azure for Azure; AZURA_API_KEY remains supported.
