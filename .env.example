# Copy to .env and fill in what you have. Never commit .env.
#
# You only need the variables for the models you run. Every model in
# src/models.json resolves at run time in this order:
#   1. the owner's own vendor endpoint  (<VENDOR>_BASE_URL + <VENDOR>_API_KEY)
#   2. the shared Azure deployment      (AZURE_OPENAI_*)
#   3. OpenRouter                       (OPENROUTER_API_KEY)
# `python src/models.py` prints which route each model would take here, and
# a model with no configured route raises instead of quietly running elsewhere.

# --- Persona simulator, rubric judge and experience judge A ------------------
# The shared Azure endpoint. Keep the key in its own file, not in this one.
AZURE_OPENAI_API_KEY_FILE=azure_api_key.txt
AZURE_OPENAI_BASE_URL=https://matraixwild.services.ai.azure.com/api/projects/MatrAIxWild/openai/v1

# --- Experience judge B ------------------------------------------------------
# A second vendor, so the judge-agreement number means something. Also the
# fallback route for every execution model without its own endpoint.
OPENROUTER_API_KEY=

# --- Execution backbones: one endpoint + key each ----------------------------
# Most of you will point these at an internal or company gateway rather than the
# public vendor. That is expected: the variable NAMES below are only defaults.
# Change them, and the model id, in src/models.json under your key's `endpoint`
# -- run.py builds its provider list from that file, so a new pair needs no code.
# The endpoint must speak OpenAI chat-completions with tool calling; if yours
# needs extra headers or a different shape, see "If your endpoint is not
# OpenRouter" in RUNNING.md. Verify with: python scripts/check_models.py <key>
# Claude Opus 5.5
CLAUDE_BASE_URL=
CLAUDE_API_KEY=
# GPT 6 Astra -- also deployed on the shared Azure endpoint
GPT6_BASE_URL=
GPT6_API_KEY=
# Muse Spark 1.1
MUSE_BASE_URL=
MUSE_API_KEY=
# Gemini 3.8 Flash
GEMINI_BASE_URL=
GEMINI_API_KEY=
# Kimi K3
KIMI_BASE_URL=
KIMI_API_KEY=
# Grok 4.7
GROK_BASE_URL=
GROK_API_KEY=
# MiniMax M3
MINIMAX_BASE_URL=
MINIMAX_API_KEY=
# Qwen 3.8 27B -- a local server needs no key
QWEN_BASE_URL=
QWEN_API_KEY=
# DeepSeek V4.1 Flash
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=

# --- Browser -----------------------------------------------------------------
# Machines without root cannot install Google Chrome; these switch the runner to
# Playwright's own download or an extracted binary.
# CHROME_CHANNEL=chromium
# CHROME_PATH=/path/to/chrome
