# Keep the secret in a separate local file; never paste it into this file.
AZURE_OPENAI_API_KEY_FILE=azure_api_key.txt
AZURE_OPENAI_BASE_URL=https://matraixwild.services.ai.azure.com/api/projects/MatrAIxWild/openai/v1

# GPT-5.6 Terra accepts only its default temperature (1) in this pipeline.
# Pass --temperature 1 to odyssey/run.py.

# Optional AWS Bedrock configuration (select --provider bedrock explicitly).
# AWS_REGION=us-west-2
# AWS_BEARER_TOKEN_BEDROCK_FILE=/secure/path/to/bedrock_api_key.txt
# Or export AWS_BEARER_TOKEN_BEDROCK in the process environment.
