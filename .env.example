# Point to a local secret file; never paste the key into this file.
AZURE_OPENAI_API_KEY_FILE=azure_api_key.txt
AZURE_OPENAI_BASE_URL=https://matraixwild.services.ai.azure.com/api/projects/MatrAIxWild/openai/v1
AZURE_OPENAI_REASONING_EFFORT=low

# Optional: use separate deployment names for the two experience-judge slots.
# Both slots reuse the judge/Azure endpoint credentials above.
